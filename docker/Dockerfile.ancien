# Environnement « Anaconda ancien » (issue #16 : pandas < 1.5 chez le client) : versions
# minimales de requirements.txt, pour attraper les fonctions pandas / matplotlib trop récentes.
#   ./dev.sh test-ancien
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 MPLCONFIGDIR=/tmp/matplotlib

RUN apt-get update && apt-get install -y --no-install-recommends tk && rm -rf /var/lib/apt/lists/*
RUN pip install "pandas==1.4.4" "numpy<1.24" "scipy<1.10" "matplotlib<3.7" "openpyxl<3.1" "xlrd" "pytest>=7"
